# ===== مطلوب =====
# مفتاح يتصل به الباعث (اللوحة) بالمحرك. اجعله طويلاً وعشوائياً (40 حرفاً فأكثر)
ENGINE_API_TOKEN=غيّر-هذا-بقيمة-طويلة-عشوائية
# سر لتشفير مفتاح Google داخل قاعدة البيانات (40 حرفاً فأكثر)، لا تغيّره بعد الحفظ
ENGINE_SECRET=غيّر-هذا-ايضا-بقيمة-طويلة-عشوائية
# قاعدة MySQL خارجية (TiDB Cloud / Aiven ...). بدونها تُحفظ البيانات في ملفات تضيع عند إعادة تشغيل Render
DATABASE_URL=mysql://user:password@host:4000/dbname
# true للقواعد السحابية التي تفرض TLS (الافتراضي true عند وجود host غير محلي)
DB_SSL=true
# المنطقة الزمنية
TZ=Asia/Riyadh
